<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dynasty Hoops GM</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{

background:linear-gradient(180deg,#07111f,#101d34,#182c49);
height:100vh;
display:flex;
justify-content:center;
align-items:center;
color:white;

}

#menu{

width:380px;

background:#111827;

border-radius:20px;

padding:30px;

box-shadow:0 0 35px rgba(0,0,0,.6);

text-align:center;

}

h1{

font-size:40px;

margin-bottom:10px;

color:#ff9f1c;

}

h2{

margin-bottom:25px;

color:#6ee7ff;

}

button{

width:100%;

padding:16px;

margin:12px 0;

font-size:18px;

border:none;

border-radius:12px;

background:#2563eb;

color:white;

cursor:pointer;

transition:.25s;

}

button:hover{

background:#1d4ed8;

transform:scale(1.03);

}

#game{

display:none;

width:95%;

max-width:1200px;

}

.card{

background:#111827;

padding:20px;

border-radius:18px;

margin:10px;

}

.top{

display:flex;

justify-content:space-between;

gap:15px;

}

.grid{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:15px;

margin-top:20px;

}

.stat{

font-size:20px;

margin:10px 0;

}

#log{

height:250px;

overflow:auto;

background:#000;

padding:15px;

border-radius:12px;

font-family:monospace;

white-space:pre-line;

}

.play{

background:#16a34a;

font-size:22px;

}

</style>

</head>

<body>

<div id="menu">

<h1>🏀</h1>

<h2>DYNASTY HOOPS GM</h2>

<button onclick="newCareer()">Nueva Carrera</button>

<button>Continuar</button>

<button>Ajustes</button>

</div>

<div id="game">

<div class="top">

<div class="card">

<h2>Puerto Plata Sharks</h2>

<div class="stat">Récord: <span id="record">0-0</span></div>

<div class="stat">Dinero: $50 M</div>

<div class="stat">Fans: 85%</div>

</div>

<div class="card">

<h2>Próximo Partido</h2>

<p>Sharks vs Wolves</p>

<button class="play" onclick="playGame()">▶ JUGAR</button>

</div>

</div>

<div class="grid">

<div class="card">

<h2>Noticias</h2>

<div id="news">

Bienvenido General Manager.

</div>

</div>

<div class="card">

<h2>Partido</h2>

<div id="log">

Esperando...

</div>

</div>

</div>

</div>

<script>

let wins=0;

let losses=0;

function newCareer(){

document.getElementById("menu").style.display="none";

document.getElementById("game").style.display="block";

}

function playGame(){

let my=85+Math.floor(Math.random()*31);

let ai=85+Math.floor(Math.random()*31);

let txt="";

txt+="🏀 Comienza el partido\n\n";

for(let i=1;i<=12;i++){

txt+="Posesión "+i+"\n";

if(Math.random()>.5){

txt+="Sharks anotan.\n";

}else{

txt+="Wolves responden.\n";

}

}

txt+="\n";

txt+="FINAL\n";

txt+="Sharks "+my+"\n";

txt+="Wolves "+ai+"\n\n";

if(my>ai){

wins++;

txt+="🏆 VICTORIA";

document.getElementById("news").innerHTML="¡Gran victoria! La afición celebra.";

}else{

losses++;

txt+="❌ DERROTA";

document.getElementById("news").innerHTML="El entrenador promete mejorar.";

}

document.getElementById("record").innerHTML=wins+"-"+losses;

document.getElementById("log").innerHTML=txt;

}

</script>

</body>

</html>